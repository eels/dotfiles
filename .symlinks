## Aerospace
$PWD/aerospace/aerospace.toml $HOME/.config/aerospace/aerospace.toml

## ASDF
$PWD/asdf/.asdfrc $HOME/.asdfrc
$PWD/asdf/.tool-versions $HOME/.tool-versions

## Ghostty
$PWD/ghostty/config.ghostty $HOME/.config/ghostty/config.ghostty

## Git
$PWD/git/.gitconfig $HOME/.gitconfig
$PWD/git/.gitconfig.local $HOME/.gitconfig.local
$PWD/git/.gitconfig.local.mts $HOME/.gitconfig.local.mts
$PWD/git/.gitignore $HOME/.gitignore

## OpenCode
$PWD/opencode/AGENTS.md $HOME/.config/opencode/AGENTS.md
$PWD/opencode/agents/analytical/* $HOME/.config/opencode/agents/*
$PWD/opencode/agents/core/* $HOME/.config/opencode/agents/*
$PWD/opencode/agents/creative/* $HOME/.config/opencode/agents/*
$PWD/opencode/agents/orchestration/* $HOME/.config/opencode/agents/*
$PWD/opencode/agents/scouting/* $HOME/.config/opencode/agents/*
$PWD/opencode/commands/* $HOME/.config/opencode/commands/*
$PWD/opencode/opencode.json $HOME/.config/opencode/opencode.json
$PWD/opencode/references/specifications/* $HOME/.config/opencode/references/specifications/*
$PWD/opencode/references/standards/* $HOME/.config/opencode/references/standards/*
$PWD/opencode/references/templates/* $HOME/.config/opencode/references/templates/*

## Sheldon
$PWD/sheldon/plugins.toml $HOME/.config/sheldon/plugins.toml

## Shell
$PWD/shell/.localrc $HOME/.localrc
$PWD/shell/.zsh_git $HOME/.zsh_git
$PWD/shell/.zshrc $HOME/.zshrc
