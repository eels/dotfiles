{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "formatter": false,
  "permissions": [
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "{env:TMPDIR}/**"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/**"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.config/opencode/**"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/dotfiles/opencode/**"
    }
  ],
  "references": {
    "design-system": {
      "description": "Default project development specifications and standards",
      "path": "~/dotfiles/opencode/references/**"
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/Users/liam/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  }
}
